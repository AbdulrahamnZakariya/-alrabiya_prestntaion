# انسخ هذا الملف إلى deploy/.env وعبّئ القيم

# الدومين (بدون https) — مثال: taqniwaiee.com
DOMAIN=

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API → console.anthropic.com (ضع حد إنفاق شهري من لوحة Anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# إيميلك (أو أكثر، مفصولة بفواصل) — صاحب لوحة التحكم وتأكيد الدفع
ADMIN_EMAILS=

# 1 = مع ماكينة المونتاج (Whisper) · 0 = بدونها
WITH_VIDEO=1
