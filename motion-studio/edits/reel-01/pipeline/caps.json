 "sentences": [
  {
   "i": 0,
   "text": "طفرة في عالم التصميم",
   "s": 0.06,
   "e": 1.81,
   "w0": 0,
   "w1": 3
  },
  {
   "i": 1,
   "text": "المصممين رح يزعلوا علينا بعد هذا الفيديو",
   "s": 2.04,
   "e": 4.44,
   "w0": 4,
   "w1": 10
  },
  {
   "i": 2,
   "text": "طبعاً",
   "s": 4.6,
   "e": 5.11,
   "w0": 11,
   "w1": 11
  },
  {
   "i": 3,
   "text": "للتأكيد وللمعلومية",
   "s": 5.28,
   "e": 6.97,
   "w0": 12,
   "w1": 13
  },
  {
   "i": 4,
   "text": "إنو الذكاء الاصطناعي فعلياً بيعملك مونتاج الفيديوهات",
   "s": 7.13,
   "e": 9.95,
   "w0": 14,
   "w1": 20
  },
  {
   "i": 5,
   "text": "بس كل ما كان إنت عندك حس بصري",
   "s": 10.11,
   "e": 12.28,
   "w0": 21,
   "w1": 28
  },
  {
   "i": 6,
   "text": "وعندك أشياء في بالك بتقدر تدخلها داخل الفيديو",
   "s": 12.44,
   "e": 15.83,
   "w0": 29,
   "w1": 36
  },
  {
   "i": 7,
   "text": "كل ما كانت النتيجة أفضل",
   "s": 15.96,
   "e": 17.36,
   "w0": 37,
   "w1": 41
  },
  {
   "i": 8,
   "text": "فالذكاء الاصطناعي",
   "s": 17.52,
   "e": 18.57,
   "w0": 42,
   "w1": 43
  },
  {
   "i": 9,
   "text": "كل ما كلّمته أكتر",
   "s": 18.83,
   "e": 19.91,
   "w0": 44,
   "w1": 47
  },
  {
   "i": 10,
   "text": "كل ما أعطاك نتائج أفضل",
   "s": 20.04,
   "e": 21.26,
   "w0": 48,
   "w1": 52
  },
  {
   "i": 11,
   "text": "فهل فعلاً اللي بيستخدم الذكاء الاصطناعي باحترافية وبيضيف الإضافات الصح",
   "s": 21.42,
   "e": 25.93,
   "w0": 53,
   "w1": 62
  },
  {
   "i": 12,
   "text": "داخل الفيديو داخل الماكينة",
   "s": 26.03,
   "e": 28.04,
   "w0": 63,
   "w1": 66
  },
  {
   "i": 13,
   "text": "نفس اللي بيستخدم استخدام عادي؟",
   "s": 28.27,
   "e": 29.93,
   "w0": 67,
   "w1": 71
  },
  {
   "i": 14,
   "text": "أكيد لا",
   "s": 30.09,
   "e": 30.86,
   "w0": 72,
   "w1": 73
  },
  {
   "i": 15,
   "text": "فبشرى",
   "s": 31.02,
   "e": 31.69,
   "w0": 74,
   "w1": 74
  },
  {
   "i": 16,
   "text": "للمصممين",
   "s": 31.88,
   "e": 32.9,
   "w0": 75,
   "w1": 75
  },
  {
   "i": 17,
   "text": "إنه إنت رح هاي الأداة تكون مساعد إلك",
   "s": 33.06,
   "e": 36.74,
   "w0": 76,
   "w1": 83
  },
  {
   "i": 18,
   "text": "وليس تحل محلك",
   "s": 36.9,
   "e": 38.18,
   "w0": 84,
   "w1": 86
  }
 ],
